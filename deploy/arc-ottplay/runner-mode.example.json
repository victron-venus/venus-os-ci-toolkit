{
  "schema": 1,
  "organization": "example-org",
  "repositories": {
    "console": {
      "repository": "example-org/console",
      "pools": {
        "smoke-linux": [
          "ottplay-k3s-linux-x64",
          "ottplay-private-ci"
        ]
      }
    },
    "mobile": {
      "repository": "example-org/mobile",
      "pools": {
        "smoke-linux": [
          "ottplay-k3s-linux-x64",
          "ottplay-private-ci"
        ],
        "smoke-kvm": [
          "ottplay-k3s-kvm-x64",
          "ottplay-private-ci"
        ],
        "smoke-release": [
          "ottplay-k3s-release-x64",
          "ottplay-private-release"
        ]
      }
    }
  },
  "groups": [
    {
      "name": "ottplay-private-ci",
      "visibility": "selected",
      "allows_public_repositories": false,
      "repositories": [
        "example-org/console",
        "example-org/mobile"
      ],
      "restricted_to_workflows": false
    },
    {
      "name": "ottplay-private-release",
      "visibility": "selected",
      "allows_public_repositories": false,
      "repositories": [
        "example-org/mobile"
      ],
      "restricted_to_workflows": true,
      "selected_workflows": [
        "example-org/mobile/.github/workflows/release.yml@refs/heads/main",
        "example-org/mobile/.github/workflows/runner-smoke.yml@refs/heads/main"
      ]
    }
  ]
}
