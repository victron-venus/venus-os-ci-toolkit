{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "npm",
    "pip_requirements",
    "gomod",
    "dockerfile"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "enabled": true
    },
    {
      "description": "Keep only the toolkit expression-test engine in the CI update group.",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "tools/runner-expressions/**"
      ],
      "enabled": true,
      "groupName": "GitHub Actions and reusable workflows",
      "groupSlug": "ci-workflows",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Regenerate the compiled, binary-only tool lock through its pinned source workflow.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "actions/setup-python/requirements.txt"
      ],
      "enabled": false
    }
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    ".github/containers/runner-go-tools/**",
    ".github/cosign/**",
    ".github/oci-tools/**",
    "actions/setup-go/tools/**",
    "tools/scorecard-scan/**",
    "tools/secret_control/**"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ]
  }
}
