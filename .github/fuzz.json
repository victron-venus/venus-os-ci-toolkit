{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "oci-metadata",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_oci_metadata.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/oci-metadata",
      "instrumentation": [
        {
          "module": "merge_oci_archives",
          "functions": [
            "document",
            "member_name"
          ]
        }
      ]
    },
    {
      "name": "version-policy",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_version_policy.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/version-policy",
      "instrumentation": [
        {
          "module": "version_plan",
          "functions": [
            "validate_policy",
            "create_plan",
            "validate_plan"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    "scripts",
    "fuzz",
    "tests"
  ],
  "preflight": [
    [
      ".fuzz-venv/bin/python",
      "tests/test_atheris_instrumentation.py",
      "-v"
    ]
  ]
}
