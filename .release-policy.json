{
  "repository": "victron-venus/venus-os-ci-toolkit",
  "mode": "release",
  "default_branch": "main",
  "validation_workflows": [
    "ci.yml",
    "security-required.yml",
    "contract-tests.yml"
  ],
  "local_checks": [
    "bash scripts/ci.sh"
  ],
  "notes": [
    "Tooling contracts cover candidate/promotion rejection cases. Retired legacy publisher/dispatcher entry points now fail with a migration message; consumers pinned to older toolkit SHAs must migrate explicitly.",
    "ci.yml already runs CodeQL; security-required.yml adds strict full-source Trivy without duplicate language analysis.",
    "Source candidates carry an explicit inventory of toolkit source and are accepted by installing locked dependencies and running contracts against the extracted archive.",
    "The source distribution version is independent of immutable workflow references. Publishing a candidate does not update consumers or establish device or deployment acceptance."
  ],
  "visibility": "public",
  "single_entry_ci": true,
  "change_scope": {
    "documentation_paths": [
      "GOVERNANCE.md",
      "TERRAFORM_IMPORT.md"
    ],
    "required_paths": [
      "CHANGELOG.md"
    ],
    "always_validate_workflows": [
      "ci.yml",
      "security-required.yml"
    ]
  },
  "artifact_pattern": "release-assets*",
  "version_file": "SOURCE_VERSION",
  "release_notes": "CHANGELOG.md",
  "toolkit_revision": "d55d9899310c9fb068fbdb36cdc42cc3f539d41c",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "toolkit_revision": "d55d9899310c9fb068fbdb36cdc42cc3f539d41c",
    "files": [
      {
        "path": "SOURCE_VERSION",
        "format": "text",
        "value": "package"
      }
    ],
    "required_build_receipts": [
      "release-inputs-package.json"
    ],
    "artifacts": [
      {
        "path": "venus-os-ci-toolkit-*.tar.gz",
        "format": "tar-text",
        "member": "venus-os-ci-toolkit/SOURCE_VERSION",
        "value": "package"
      }
    ]
  },
  "fuzzing": {
    "toolkit_ref": "4774181674f4a1a18488bfc918b4c5ed1df39163"
  },
  "container_assets": {
    "oci-builder-linux-amd64.oci.tar": "ghcr.io/victron-venus/oci-builder-amd64",
    "oci-builder-linux-arm64.oci.tar": "ghcr.io/victron-venus/oci-builder-arm64"
  }
}
